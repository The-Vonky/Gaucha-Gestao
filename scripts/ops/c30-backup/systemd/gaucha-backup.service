[Unit]
Description=Backup cifrado do STAGING Gaúcha Gestão
Requisite=docker.service
After=docker.service network-online.target
Wants=network-online.target
OnFailure=gaucha-backup-alert@%n.service

[Service]
Type=oneshot
User=root
UMask=0077
TimeoutStartSec=2h
KillMode=control-group
ExecStart=/usr/bin/python3 /opt/gaucha-backup/backup.py backup
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/gaucha-backup /etc/gaucha-gestao/backup/drive
