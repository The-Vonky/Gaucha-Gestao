IMGPROXY_BIND=127.0.0.1:8080
IMGPROXY_LOCAL_FILESYSTEM_ROOT=/isolated
IMGPROXY_ALLOWED_SOURCES=local://
IMGPROXY_ALLOW_PRIVATE_SOURCE_ADDRESSES=false
IMGPROXY_MAX_SRC_FILE_SIZE=10485760
IMGPROXY_MAX_SRC_RESOLUTION=50
IMGPROXY_MAX_RESULT_DIMENSION=480
IMGPROXY_MAX_ANIMATION_FRAMES=1
IMGPROXY_TIMEOUT=8
IMGPROXY_WORKERS=1
IMGPROXY_REQUESTS_QUEUE_SIZE=4
